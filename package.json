{
  "name": "keyte-hipkins-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node backend/build-site.js",
    "test": "node --test tests/*.test.js",
    "dev:api": "wrangler dev --config backend/wrangler.jsonc",
    "db:local": "wrangler d1 execute DB --local --config backend/wrangler.jsonc --file backend/schema.sql",
    "deploy:api": "wrangler deploy --config backend/wrangler.jsonc"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
